from flask import Flask, request, render_template_string
from itertools import combinations
import sqlite3

app = Flask(__name__)

SPIELER = [
    "Eike Be", "Eike Br", "Marc", "Kai",
    "Mirco", "Wilke", "Niko", "Meyer",
    "Elton", "Süne", "Jannes", "Daniel"
]

DB = "historie.db"

HTML = """
<!doctype html>
<html>
<head>
    <title>Spieltag Planer</title>
    <style>
        body{
            font-family:Arial;
            max-width:900px;
            margin:auto;
            padding:20px;
        }
        .spieler{
            display:inline-block;
            width:200px;
            margin:4px;
        }
        .spiel{
            padding:10px;
            margin:10px 0;
            background:#f0f0f0;
            border-radius:8px;
        }
    </style>
</head>
<body>

<h1>2 gegen 2 Spieltag-Planer</h1>

<form method="post">

{% for s in spieler %}
<div class="spieler">
