import streamlit as st
import sqlite3
from itertools import combinations

DB = "historie.db"

STANDARD_SPIELER = [
    "Eike Be", "Eike Br", "Marc", "Kai",
    "Mirco", "Wilke", "Meyer", "Elton",
    "Daniel", "Süne", "Jannes", "Daniel"
]


# -----------------------------------------
# Datenbank
# -----------------------------------------

def init_db():
    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute("""
    CREATE TABLE IF NOT EXISTS paare(
        a TEXT,
        b TEXT,
        team INTEGER DEFAULT 0,
        gegner INTEGER DEFAULT 0,
        UNIQUE(a,b)
    )
    """)

    conn.commit()
    conn.close()


def hole_werte(a, b):

    a, b = sorted([a, b])

    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute(
        "SELECT team, gegner FROM paare WHERE a=? AND b=?",
        (a, b)
    )

    r = c.fetchone()

    conn.close()

    if r:
        return r

    return (0, 0)


def speichern(a, b, typ):

    a, b = sorted([a, b])

    conn = sqlite3.connect(DB)
    c = conn.cursor()

    c.execute("""
    INSERT OR IGNORE INTO paare(a,b,team,gegner)
    VALUES(?,?,0,0)
    """, (a, b))

    if typ == "team":
        c.execute("""
        UPDATE paare
        SET team = team + 1
        WHERE a=? AND b=?
        """, (a, b))

    else:
        c.execute("""
        UPDATE paare
        SET gegner = gegner + 1
        WHERE a=? AND b=?
        """, (a, b))

    conn.commit()
    conn.close()


# -----------------------------------------
# Optimierung
# -----------------------------------------

def kosten(team1, team2):

    wert = 0

    # Mitspieler möglichst vermeiden
    for p in combinations(team1, 2):
        wert += hole_werte(*p)[0] * 20

    for p in combinations(team2, 2):
        wert += hole_werte(*p)[0] * 20

    # Gegner ebenfalls verteilen
    for a in team1:
        for b in team2:
            wert += hole_werte(a, b)[1]

    return wert


def spieltag_berechnen(anwesend):

    anwesend = list(anwesend)

    spiele = []

    while len(anwesend) >= 4:

        beste_kosten = 999999999
        beste_losung = None

        for vierer in combinations(anwesend, 4):

            a, b, c, d = vierer

            varianten = [
                ((a, b), (c, d)),
                ((a, c), (b, d)),
                ((a, d), (b, c))
            ]

            for team1, team2 in varianten:

                k = kosten(team1, team2)

                if k < beste_kosten:
                    beste_kosten = k
                    beste_losung = (vierer, team1, team2)

        vierer, team1, team2 = beste_losung

        spiele.append((team1, team2))

        for p in combinations(team1, 2):
            speichern(*p, "team")

        for p in combinations(team2, 2):
            speichern(*p, "team")

        for a in team1:
            for b in team2:
                speichern(a, b, "gegner")

        for s in vierer:
            anwesend.remove(s)

    return spiele, anwesend


# -----------------------------------------
# Statistik
# -----------------------------------------

def lade_statistik():

    conn = sqlite3.connect(DB)

    daten = conn.execute("""
    SELECT a,b,team,gegner
    FROM paare
    ORDER BY team DESC, gegner DESC
    """).fetchall()

    conn.close()

    return daten


# -----------------------------------------
# UI
# -----------------------------------------

init_db()

st.set_page_config(
    page_title="Spieltag Planer",
    layout="wide"
)

st.title("🏆 Spieltag Planer 2 gegen 2")

st.subheader("Anwesende Spieler auswählen")

anwesend = []

cols = st.columns(3)

for i, spieler in enumerate(STANDARD_SPIELER):

    with cols[i % 3]:

        if st.checkbox(spieler):
            anwesend.append(spieler)

st.divider()

if st.button("Spieltag berechnen", type="primary"):

    if len(anwesend) < 4:

        st.error("Mindestens 4 Spieler erforderlich.")

    else:

        spiele, uebrige = spieltag_berechnen(anwesend)

        st.success("Spieltag erstellt")

     
